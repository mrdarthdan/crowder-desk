  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions shared by the desktop widget and the iPhone app",
  "windows": ["main", "recipe"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "obsidian://*" }]
    }
  ]
}
